# ---- 端口（严格按批次计划：FE 18227 / BE 19227 / 宿主机 DB 17727）----
COMPOSE_PROJECT_NAME=featpoint
FRONTEND_PORT=18227
BACKEND_PORT=19227
DB_PORT=17727

# ---- 数据库 ----
DB_NAME=featpoint
DB_USER=featpoint
DB_PASSWORD=featpoint_pwd
DB_HOST=db
# 容器内 PostgreSQL 端口固定 5432（compose 中 backend/worker 已显式覆盖 DB_PORT=5432）

# ---- JWT ----
JWT_SECRET=featpoint_demo_jwt_secret_please_change
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ---- 演示 seed ----
SEED_DEMO=true

# ---- 限流 / 配额 ----
RATE_WINDOW_SECONDS=60
RATE_WINDOW_MAX=60
DAILY_RUN_QUOTA=20
